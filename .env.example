# ─────────────────────────────────────────────────────────────
# Contact form email delivery (OPTIONAL)
# The form works without any of this — submissions are validated
# and logged. Set these to actually receive inquiries by email.
# ─────────────────────────────────────────────────────────────

# API key from https://resend.com (free tier is plenty to start)
RESEND_API_KEY=

# Where inquiries should be delivered
CONTACT_TO_EMAIL=hello@wellkeptestates.space

# Optional: a verified sender address in your Resend account.
# Defaults to Resend's shared onboarding@resend.dev if left blank.
CONTACT_FROM_EMAIL=
